@template.layout(title = "Förfrågan finns inte", content = @`
    <h1>Förfrågan finns inte</h1>
    <p class="lede">Länken stämmer inte, eller så har förfrågan raderats.</p>
    <p>Förfrågningar raderas automatiskt en till två månader efter att de skapats.
        Har du fått länken av någon får du gärna höra av dig till den personen.</p>
    <div class="actions">
        <a class="button secondary" href="/">Skapa en ny förfrågan</a>
    </div>
`)
