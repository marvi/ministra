# Mall för env-filen (D-014). Kopiera till ministra.env på servern, fyll i värdena och
# sätt läge 0600. Filen ligger aldrig i repot.
#
#   install -m 0600 /dev/null ~/.config/ministra/ministra.env
#
# systemd tolkar inte skalsyntax: $ANNAN_VARIABEL expanderas inte, och citattecken blir
# en del av värdet om de inte omsluter hela värdet.

# Publik adress, utan avslutande snedstreck. Alla länkar i mejlen byggs från den (D-022).
MINISTRA_BASE_URL=https://ministra.marvi.work

# Databasen är en delad produktionsinstans på värden (D-015). Egen databas och egen roll,
# aldrig superuser. host.containers.internal når värden från containern.
MINISTRA_DB_URL=jdbc:postgresql://host.containers.internal:5432/ministra
MINISTRA_DB_USER=ministra
MINISTRA_DB_PASSWORD=

# AhaSend över SMTP (D-029). Byte av leverantör är de här fyra raderna, inget mer.
SPRING_MAIL_HOST=send.ahasend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true

# Avsändaradress på den verifierade domänen med SPF och DKIM.
MINISTRA_MAIL_FROM=ministra@ministra.marvi.work

# Tak för antal skapade förfrågningar per IP och timme (D-017).
MINISTRA_CREATES_PER_HOUR_PER_IP=10

# Rootless podman kan inte binda portar under 1024. Reverse proxyn tar 443 (D-034).
SERVER_PORT=8080
